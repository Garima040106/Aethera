VITE_API_BASE_URL=http://localhost:8000
# AMAZON_LOCATION is read from frontend/.env.local by vite.config.ts; never commit a real key here.
# VITE_AWS_REGION defaults to us-east-1, but set the region where the Location API key was created.
# VITE_AWS_REGION=us-east-1
# Set to the name of an existing Amazon Location map resource in this region.
# AWS_LOCATION_MAP_NAME=
# Optional. The endpoint must accept POST { geometry: { type: "LineString", coordinates } }
# and return { average_aqi, is_green_corridor, source, observed_at }.
# VITE_ROUTE_AQI_SCORE_URL=http://localhost:8000/api/routes/score
