# Saans Saathi Configuration

# Backend API Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# AWS Credentials (Optional for local mode; local deterministic fallback active when omitted)
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Amazon Bedrock Model Selection
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# External Environmental Data Keys (Optional - fixtures used if empty)
# NASA_FIRMS_MAP_KEY=
# OPENAQ_API_KEY=

# Application Safeguards
ENABLE_LOCAL_AGENT_FALLBACK=true
ENABLE_FIXTURE_REPLAY_MODE=true
MAX_FORECAST_HORIZON_HOURS=72
DEFAULT_FORECAST_AREA=noida
